    @legacy_peak_arguments);
my ($legacy_peak_61, $legacy_peak_61_error) = run_value('-k', '6',
    @legacy_peak_arguments);
check_result('legacy Sigma transitions are explicit quadrature boundaries',
    defined $legacy_peak_15 && defined $legacy_peak_61 &&
    close_enough($legacy_peak_15, $legacy_peak_61, 2e-10, 1e-3),
    defined $legacy_peak_15 && defined $legacy_peak_61
        ? "15-point=$legacy_peak_15 61-point=$legacy_peak_61"
        : "$legacy_peak_15_error $legacy_peak_61_error");

my ($outside_status) = run_bubble('-M', '0', 1, 0, 0, 0.1, 0,
    $outside_resigma, $outside_imsigma);
check_result('M=0 permits grid without zero', $outside_status == 0,
    "exit=$outside_status");

my ($verbose_status, $verbose_stdout, $verbose_stderr) = run_bubble(
    '-v', '-M', '0.5', 1, 2, 0, 0.1, 0, $resigma, $imsigma);
check_result('verbose resolved window', $verbose_status == 0 &&
    $verbose_stdout =~ /cutoff=30(?:\.0+)?(?:\s|$)/ &&
    $verbose_stdout =~ /ReSigma\(0\)=/ &&
    $verbose_stdout =~ /epsilon window=\[-0\.5,0\.5\]/,
    "exit=$verbose_status stderr=$verbose_stderr");

print "WINDOW OK=$passed FAILED=$failed\n";
exit($failed == 0 ? 0 : 1);
