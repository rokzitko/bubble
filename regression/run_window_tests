    my ($base_status, $base_stdout, $base_stderr) = run_bubble(@$case);
    my ($zero_status, $zero_stdout, $zero_stderr) = run_bubble('-M', '0', @$case);
    check_result('M=0 exact pass-through',
        $base_status == $zero_status && $base_stdout eq $zero_stdout &&
        $base_stderr eq $zero_stderr,
        "base_exit=$base_status zero_exit=$zero_status");
}

