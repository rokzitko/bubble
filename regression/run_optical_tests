#!/usr/bin/env perl

use strict;
use warnings;
use File::Temp qw(tempfile);
use FindBin qw($Bin);
use IPC::Open3;
use Symbol qw(gensym);

my $bubble = "$Bin/../bubble";
my $resigma = "$Bin/resigma_1.dat";
my $imsigma = "$Bin/imsigma_1.dat";
my $small_im_resigma = "$Bin/resigma_22.dat";
my $small_im_imsigma = "$Bin/imsigma_22.dat";
my $positive_sigma = "$Bin/resigma_3.dat";
my $bethe_resigma = "$Bin/../Bethe_lattice_test/resigma.dat";
my $bethe_imsigma = "$Bin/../Bethe_lattice_test/imsigma.dat";
my $number = qr/[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?/;
my $passed = 0;
my $failed = 0;
my @tight_tolerances = ('-a', '1e-12', '-r', '1e-12', '-c', '15');

sub run_bubble {
    my (@arguments) = @_;
    my $stdout = gensym;
    my $stderr = gensym;
    my $pid = open3(undef, $stdout, $stderr, $bubble, @arguments);

    my $stdout_text = do { local $/; <$stdout> } // '';
    my $stderr_text = do { local $/; <$stderr> } // '';
    $stderr_text =~ s/\s+$//;
    waitpid $pid, 0;
    my $wait_status = $?;
    my $status = ($wait_status & 127) ? 128 + ($wait_status & 127) : $wait_status >> 8;
    return ($status, $stdout_text, $stderr_text);
}

sub run_value {
    my (@arguments) = @_;
    my ($status, $stdout, $stderr) = run_bubble(@arguments);
    return (undef, "exit=$status stderr=$stderr") if $status != 0;
    return (undef, "unexpected output=$stdout") unless $stdout =~ /^\s*($number)\s*$/;
    return ($1 + 0.0, '');
}

sub check_result {
    my ($name, $ok, $details) = @_;
    if ($ok) {
        ++$passed;
        print "OK: $name";
    } else {
        ++$failed;
        print "FAILED: $name";
    }
    print " ($details)" if defined $details && length $details;
    print "\n";
}

sub relative_error {
    my ($value, $expected) = @_;
    return abs($value - $expected)/abs($expected);
}

sub write_constant_sigma {
    my ($name, @frequencies) = @_;
    my ($re_file, $re_filename) = tempfile(
        "bubble-$name-re-XXXX", TMPDIR => 1, UNLINK => 1);
    my ($im_file, $im_filename) = tempfile(
        "bubble-$name-im-XXXX", TMPDIR => 1, UNLINK => 1);
    for my $frequency (@frequencies) {
        print {$re_file} "$frequency 0\n";
        print {$im_file} "$frequency -0.1\n";
    }
    close $re_file or die "Cannot close $re_filename: $!\n";
    close $im_file or die "Cannot close $im_filename: $!\n";
    return ($re_filename, $im_filename);
}

-x $bubble or die "Executable not found: $bubble\n";

my @even_kernels = (1, 3, 5, 7);
for my $kernel (@even_kernels) {
    my @arguments = ($kernel, 2, 0, 0.1, 0, $resigma, $imsigma);
    my ($dc, $dc_error) = run_value(@arguments);
    my ($zero, $zero_error) = run_value('-O', '0', @arguments);
    my $ok = defined $dc && defined $zero && $dc == $zero;
    check_result("m=$kernel exact Omega=0 limit", $ok, $ok ? "value=$dc" : "$dc_error $zero_error");

    my ($small, $small_error) = run_value('-O', '1e-8', @arguments);
    $ok = defined $dc && defined $small && relative_error($small, $dc) < 1e-9;
    check_result("m=$kernel small Omega limit", $ok,
        $ok ? "relative_error=" . relative_error($small, $dc) : "$small_error dc=$dc small=$small");
}

my @frequency_window_arguments = (1, 2, 0, 0.1, 0, $resigma, $imsigma);
my ($windowed_dc, $windowed_dc_error) = run_value(
    '-Mp', '0.2', @frequency_window_arguments);
my ($windowed_zero, $windowed_zero_error) = run_value(
    '-Mp', '0.2', '-O', '0', @frequency_window_arguments);
check_result("spectral-frequency window exact Omega=0 limit",
    defined $windowed_dc && defined $windowed_zero &&
    $windowed_dc == $windowed_zero,
    defined $windowed_dc && defined $windowed_zero
        ? "value=$windowed_dc" : "$windowed_dc_error $windowed_zero_error");

my ($windowed_optical, $windowed_optical_error) = run_value(
    '-Mp', '0.2', '-O', '0.1', @frequency_window_arguments);
my ($bounded_optical, $bounded_optical_error) = run_value(
    '-c', '1', '-O', '0.1', @frequency_window_arguments);
check_result('spectral-frequency optical overlap uses both masks',
    defined $windowed_optical && defined $bounded_optical &&
    $windowed_optical == $bounded_optical,
    defined $windowed_optical && defined $bounded_optical
        ? "value=$windowed_optical"
        : "$windowed_optical_error $bounded_optical_error");

my ($above_window, $above_window_error) = run_value(
    '-Mp', '0.2', '-O', '0.3', @frequency_window_arguments);
check_result("optical response can survive M'<Omega<2M'",
    defined $above_window && $above_window > 0.0,
    defined $above_window ? "value=$above_window" : $above_window_error);

my ($empty_window, $empty_window_error) = run_value(
    '-Mp', '0.2', '-O', '0.4', @frequency_window_arguments);
check_result("optical response vanishes at Omega=2M'",
    defined $empty_window && $empty_window == 0.0,
    defined $empty_window ? "value=$empty_window" : $empty_window_error);

# Independent direct epsilon/omega quadrature for constant Sigma=-0.1i.
my %finite_reference = (
    1 => 0.4885903945334426,
    3 => 0.4708182948628991,
    5 => 0.4420559614703037,
    7 => 0.4343363161009058,
);
for my $kernel (@even_kernels) {
    my ($value, $error) = run_value(
        @tight_tolerances, '-O', '0.3', $kernel, 2, 0, 0.1, 0, $resigma, $imsigma,
    );
    my $expected = $finite_reference{$kernel};
    my $tolerance = 5e-12 + 1e-10*abs($expected);
    my $ok = defined $value && abs($value - $expected) <= $tolerance;
    check_result("m=$kernel finite Omega reference", $ok,
        $ok ? "absolute_error=" . abs($value - $expected) : "$error expected=$expected value=$value");
}

my ($large, $large_error) = run_value(
    @tight_tolerances, '-O', '2', 1, 2, 0, 0.1, 0, $resigma, $imsigma,
);
my $large_expected = 0.008339741084697084;
my $large_ok = defined $large && abs($large - $large_expected) <= 1e-11;
check_result('large Omega shifted integration range', $large_ok,
    $large_ok ? "absolute_error=" . abs($large - $large_expected) : "$large_error value=$large");

my @far_options = ('-c', '15', '-a', '1e-50', '-r', '1e-10');
my @far_arguments = (1, 2, 0, 0.01, 1e8, $small_im_resigma, $small_im_imsigma);
my ($far_dc, $far_dc_error) = run_value(@far_options, '-O', '0', @far_arguments);
my ($far_optical, $far_optical_error) = run_value(
    @far_options, '-O', '1e-5', @far_arguments);
my $far_ok = defined $far_dc && defined $far_optical && $far_optical > 0 &&
    relative_error($far_optical, $far_dc) < 1e-8;
check_result('far exterior optical cancellation is resolved', $far_ok,
    $far_ok ? "dc=$far_dc optical=$far_optical"
            : "$far_dc_error $far_optical_error dc=$far_dc optical=$far_optical");

my $gaussian_expected = 1.3512228260316294e-139;
my ($gaussian_pole, $gaussian_pole_error) = run_value(
    '-i', '1', '-c', '15', '-a', '1e-152', '-r', '1e-9', '-s', '1e-100',
    '-O', '9.094947017729282e-13',
    7, 2, 0, '9.094947017729282e-13', 8.5, $resigma, $positive_sigma,
);
my $gaussian_pole_ok = defined $gaussian_pole && $gaussian_pole > 0 &&
    relative_error($gaussian_pole, $gaussian_expected) < 1e-8;
check_result('Gaussian exterior optical pole is retained', $gaussian_pole_ok,
    $gaussian_pole_ok ? "relative_error=" . relative_error($gaussian_pole, $gaussian_expected)
                      : "$gaussian_pole_error expected=$gaussian_expected value=$gaussian_pole");

my ($phi_file, $phi_filename) = tempfile('bubble-phi-XXXX', TMPDIR => 1, UNLINK => 1);
for my $point (-10 .. 10) {
    print {$phi_file} $point/10, " 1\n";
}
close $phi_file or die "Cannot close $phi_filename: $!\n";
my ($exact_optical_re, $exact_optical_im) =
    write_constant_sigma('exact-optical', '-4', '4');
my ($short_optical_lower_re, $short_optical_lower_im) =
    write_constant_sigma('short-optical-lower', '-3.9999999999999996', '4');
my ($short_optical_upper_re, $short_optical_upper_im) =
    write_constant_sigma('short-optical-upper', '-4', '3.9999999999999996');
my ($shifted_boundary_re, $shifted_boundary_im) =
    write_constant_sigma('shifted-boundary', '-1', '1');
my ($frequency_window_exact_re, $frequency_window_exact_im) =
    write_constant_sigma('frequency-window-exact', '-0.2', '0.2');
my ($frequency_window_short_lower_re, $frequency_window_short_lower_im) =
    write_constant_sigma('frequency-window-short-lower',
        '-0.19999999999999998', '0.2');
my ($frequency_window_short_upper_re, $frequency_window_short_upper_im) =
    write_constant_sigma('frequency-window-short-upper',
        '-0.2', '0.19999999999999998');
my ($frequency_window_disjoint_re, $frequency_window_disjoint_im) =
    write_constant_sigma('frequency-window-disjoint', '1', '2');
my ($tabulated, $tabulated_error) = run_value(
    @tight_tolerances, '-E', '-q', '-O', '0.3', '-p', $phi_filename,
    0, 2, 0, 0.1, 0, $resigma, $imsigma,
);
my $tabulated_expected = $finite_reference{1};
my $tabulated_ok = defined $tabulated && abs($tabulated - $tabulated_expected) <= 1e-10;
check_result('tabulated m=0 optical kernel', $tabulated_ok,
    $tabulated_ok ? "absolute_error=" . abs($tabulated - $tabulated_expected)
                  : "$tabulated_error expected=$tabulated_expected value=$tabulated");

my ($exact_optical_status, $exact_optical_stdout, $exact_optical_stderr) =
    run_bubble('-O', '0.25',
        1, 2, 0, 0.125, 0, $exact_optical_re, $exact_optical_im);
check_result('positive optical exact closed Sigma coverage succeeds',
    $exact_optical_status == 0 && $exact_optical_stdout =~ /^\s*$number\s*$/ &&
    $exact_optical_stderr eq '',
    "exit=$exact_optical_status stderr=$exact_optical_stderr");

my ($frequency_window_coverage_status, $frequency_window_coverage_stdout,
    $frequency_window_coverage_stderr) = run_bubble(
        '-Mp', '0.2', '-O', '0.1',
        1, 2, 0, 0.1, 0,
        $frequency_window_exact_re, $frequency_window_exact_im);
check_result('optical spectral-frequency exact Sigma coverage succeeds',
    $frequency_window_coverage_status == 0 &&
    $frequency_window_coverage_stdout =~ /^\s*$number\s*$/ &&
    $frequency_window_coverage_stderr eq '',
    "exit=$frequency_window_coverage_status stderr=$frequency_window_coverage_stderr");

for my $case (
    ['lower', $frequency_window_short_lower_re,
        $frequency_window_short_lower_im],
    ['upper', $frequency_window_short_upper_re,
        $frequency_window_short_upper_im],
) {
    my ($side, $re_file, $im_file) = @$case;
    my ($status, $stdout, $stderr) = run_bubble(
        '-Mp', '0.2', '-O', '0.1',
        1, 2, 0, 0.1, 0, $re_file, $im_file);
    check_result("optical spectral-frequency one-ULP-short $side coverage is fatal",
        $status == 1 && $stdout eq '' &&
        $stderr =~ /does not cover the required closed interval/,
        "exit=$status stderr=$stderr");
}

my ($empty_coverage_status, $empty_coverage_stdout, $empty_coverage_stderr) =
    run_bubble('-Mp', '0.2', '-O', '0.4',
        1, 2, 0, 0.1, 0,
        $frequency_window_disjoint_re, $frequency_window_disjoint_im);
check_result('empty optical spectral-frequency interval needs no Sigma coverage',
    $empty_coverage_status == 0 && $empty_coverage_stdout =~ /^\s*0\s*$/ &&
    $empty_coverage_stderr eq '',
    "exit=$empty_coverage_status stderr=$empty_coverage_stderr");

for my $case (
    ['lower', $short_optical_lower_re, $short_optical_lower_im],
    ['upper', $short_optical_upper_re, $short_optical_upper_im],
) {
    my ($side, $re_file, $im_file) = @$case;
    my ($status, $stdout, $stderr) = run_bubble('-O', '0.25',
        1, 2, 0, 0.125, 0, $re_file, $im_file);
    check_result("positive optical one-ULP-short $side coverage is fatal",
        $status == 1 && $stdout eq '' &&
        $stderr =~ /required closed interval \[-4, 4\]/,
        "exit=$status stderr=$stderr");
}

my @warning_arguments = (
    '-O', '10', 1, 2, 0, 0.1, 0, $resigma, $imsigma,
);
for my $case (
    ['default', []],
    ['quiet', ['-q']],
    ['integration compatibility', ['-E']],
) {
    my ($name, $options) = @$case;
    my ($status, $stdout, $stderr) = run_bubble(@$options, @warning_arguments);
    check_result("$name incomplete optical Sigma coverage is fatal",
        $status == 1 && $stdout eq '' &&
        $stderr =~ /Error: optical self-energy table interval .*required closed interval \[-13, 13\]/s,
        "exit=$status stderr=$stderr");
}

my ($zero_coverage_status, $zero_coverage_stdout, $zero_coverage_stderr) =
    run_bubble('-c', '150', '-O', '0',
        1, 2, 0, 0.1, 0, $resigma, $imsigma);
check_result('Omega=0 uses the DC Sigma coverage contract',
    $zero_coverage_status == 1 && $zero_coverage_stdout eq '' &&
    $zero_coverage_stderr =~ /Error: DC self-energy table interval .*\[-15, 15\]/s,
    "exit=$zero_coverage_status stderr=$zero_coverage_stderr");

my @legacy_warning_arguments =
    ('--allow-legacy-self-energy-extrapolation', @warning_arguments);
my ($warning_status, $warning_stdout, $warning_stderr) =
    run_bubble(@legacy_warning_arguments);
my $warning_count = () = $warning_stderr =~ /uses legacy self-energy extrapolation/g;
my $warning_ok = $warning_status == 0 &&
    $warning_stdout =~ /^\s*$number\s*$/ && $warning_count == 1;
check_result('explicit legacy optical extrapolation warns once', $warning_ok,
    "exit=$warning_status stderr=$warning_stderr");

my ($quiet_status, $quiet_stdout, $quiet_stderr) =
    run_bubble('-q', @legacy_warning_arguments);
my $quiet_ok = $quiet_status == 0 && $quiet_stderr eq '' &&
    $quiet_stdout eq $warning_stdout;
check_result('quiet mode suppresses the legacy optical warning', $quiet_ok,
    "exit=$quiet_status stderr=$quiet_stderr output_unchanged=" .
        ($quiet_stdout eq $warning_stdout));

my ($verbose_warning_status, $verbose_warning_stdout, $verbose_warning_stderr) =
    run_bubble('-v', @legacy_warning_arguments);
my ($verbose_status, $verbose_stdout, $verbose_stderr) =
    run_bubble('-q', '-v', @legacy_warning_arguments);
my $verbose_ok = $verbose_warning_status == 0 && $verbose_status == 0 &&
    $verbose_warning_stderr =~ /Warning:/ && $verbose_stderr eq '' &&
    $verbose_stdout eq $verbose_warning_stdout &&
    $verbose_stdout =~ /bubble version/ && $verbose_stdout =~ /Result\s*=/ &&
    $verbose_stdout =~ /Error\s*=/;
check_result('quiet mode preserves verbose legacy output', $verbose_ok,
    "exit=$verbose_status stderr=$verbose_stderr");

my @shifted_boundary_options = (
    '--allow-legacy-self-energy-extrapolation', '-q', '-c', '15',
    '-s', '1e-10', '-O', '0.3',
);
my @shifted_boundary_cases = (
    ['unrestricted', [1, 2, 0, 0.1, 0,
        $shifted_boundary_re, $shifted_boundary_im]],
    ['tabulated', ['-p', $phi_filename, 0, 2, 0, 0.1, 0,
        $shifted_boundary_re, $shifted_boundary_im]],
    ['restricted', ['-M', '0.5', 1, 2, 0, 0.1, 0,
        $shifted_boundary_re, $shifted_boundary_im]],
);
for my $case (@shifted_boundary_cases) {
    my ($name, $arguments) = @$case;
    my ($value_15, $error_15) = run_value(
        '-k', '1', @shifted_boundary_options, @$arguments);
    my ($value_61, $error_61) = run_value(
        '-k', '6', @shifted_boundary_options, @$arguments);
    check_result("$name shifted Sigma transitions are quadrature boundaries",
        defined $value_15 && defined $value_61 &&
        abs($value_15 - $value_61) <= 2e-9 + 2e-9*abs($value_61),
        defined $value_15 && defined $value_61
            ? "15-point=$value_15 61-point=$value_61"
            : "$error_15 $error_61");
}

my @roundoff_arguments = (
    '-O', '0.1', 5, 2, 0, 0.27, 0, $bethe_resigma, $bethe_imsigma,
);
my ($roundoff_strict_status, $roundoff_strict_stdout, $roundoff_strict_stderr) =
    run_bubble(@roundoff_arguments);
my $roundoff_strict_ok = $roundoff_strict_status == 1 &&
    $roundoff_strict_stdout eq '' &&
    $roundoff_strict_stderr =~ /Error: Optical frequency integration: roundoff error/;
check_result('optical roundoff is fatal by default', $roundoff_strict_ok,
    "exit=$roundoff_strict_status stderr=$roundoff_strict_stderr");

my ($roundoff_status, $roundoff_stdout, $roundoff_stderr) =
    run_bubble('-E', @roundoff_arguments);
my ($roundoff_quiet_status, $roundoff_quiet_stdout, $roundoff_quiet_stderr) =
    run_bubble('-E', '-q', @roundoff_arguments);
my $roundoff_ok = $roundoff_status == 0 && $roundoff_quiet_status == 0 &&
    $roundoff_stderr =~ /Warning: ignoring integration error: Optical frequency integration:/ &&
    $roundoff_quiet_stderr eq '' && $roundoff_stdout =~ /^\s*$number\s*$/ &&
    $roundoff_quiet_stdout eq $roundoff_stdout;
check_result('optical roundoff compatibility mode', $roundoff_ok,
    "exit=$roundoff_quiet_status stderr=$roundoff_quiet_stderr");

my @invalid_cases = (
    ['negative Omega', qr/Invalid optical frequency/, '-O', '-0.1', 5, 2, 0, 0.1, 0, $resigma, $imsigma],
    ['non-finite Omega', qr/Invalid optical frequency/, '-O', 'nan', 5, 2, 0, 0.1, 0, $resigma, $imsigma],
    ['optical n!=2', qr/Option -O requires n=2/, '-O', '0.1', 5, 1, 0, 0.1, 0, $resigma, $imsigma],
    ['optical with -f', qr/Options -O and -f cannot be used together/, '-O', '0.1', '-f', 5, 2, 0, 0.1, 0, $resigma, $imsigma],
    ['optical with -d', qr/Options -O and -d cannot be used together/, '-O', '0.1', '-d', 0, 2, 0, 0.1, 0, $resigma, $imsigma],
    ['zero ImSigma floor', qr/Invalid ImSigma clipping floor/, '-s', '0', 5, 2, 0, 0.1, 0, $resigma, $imsigma],
    ['quiet mode preserves errors', qr/Invalid optical frequency/, '-q', '-O', '-0.1', 5, 2, 0, 0.1, 0, $resigma, $imsigma],
);
for my $case (@invalid_cases) {
    my ($name, $diagnostic, @arguments) = @$case;
    my ($status, $stdout, $stderr) = run_bubble(@arguments);
    check_result($name, $status == 1 && $stderr =~ $diagnostic,
        "exit=$status stderr=$stderr");
}

print "OPTICAL OK=$passed FAILED=$failed\n";
exit($failed == 0 ? 0 : 1);
