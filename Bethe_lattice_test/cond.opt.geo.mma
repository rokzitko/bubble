#!/usr/bin/env perl
# Rok Zitko, March 2016, v2
# Bethe lattice
# Results in units of sigma_MIR.

chomp(my $TD = `getparam T param.loop`);
print "T/D=$TD\n";

$beta = 1/$TD;

open(F, ">tmp.tmp") or die;
print F <<ENDSCRIPT;

Off[NIntegrate::slwcon];

Phi[eps_] = (1-eps^2)^(3/2);

CLIP = 10^-16;
clip[x_] := If[x > -CLIP, -CLIP, x];

t = Import["imsigma.dat"]; (* no res/ !! *)
t = Map[{First[#], clip[Last[#]]}&, t];
im = Map[{First[#], I Last[#]}&, t];
t = Import["resigma.dat"];
re = Map[{First[#],   Last[#]}&, t];
t = re + im;
t[[All,1]] = re[[All,1]];

\\[CapitalSigma] = Interpolation[t, InterpolationOrder -> 2];

\\[Beta] = $beta;
T=1/\\[Beta];

Print["Sigma(0)=", \\[CapitalSigma][0] ];
Print["Sigma(T)=", \\[CapitalSigma][T] ];
Print["Sigma(2T)=", \\[CapitalSigma][2T] ];

f[x_] := 1/(1+Exp[\\[Beta] x]);

calc[o_] := Module[{},
 F = (f[\\[Omega]]-f[\\[Omega]+o])/o;
 (* Print["F[0]=", F /. \\[Omega]->0]; *)

 cond = NIntegrate[ F Phi[\\[Epsilon]] *
    Im[1/( \\[Omega]    - \\[Epsilon] - \\[CapitalSigma] [\\[Omega]] )] *
    Im[1/((\\[Omega]+o) - \\[Epsilon] - \\[CapitalSigma] [\\[Omega]+o] )],
	{\\[Omega], -20T-o, -o, 0, 20T}, {\\[Epsilon], -1, 0, 1}, MaxRecursion -> 12,
  WorkingPrecision -> 14];

 condMIR = cond * 2/Pi
];

r=1.5;
imax = Floor[20/Log[r]];

omlist = Table[ 10.^-8 r^i, {i, 0, imax}];

tab = Map[Echo[{#, calc[#]}] &, omlist];
Export["cond.opt.geo-mma.dat", tab];

ENDSCRIPT

close(F);

system "math -batchinput -batchoutput <tmp.tmp";
unlink "tmp.tmp";
