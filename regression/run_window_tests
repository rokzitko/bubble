sub run_bubble {
    my (@arguments) = @_;
    my $stdout = gensym;
    my $stderr = gensym;
    my $pid = open3(undef, $stdout, $stderr, $bubble, @arguments);
    my $stdout_text = do { local $/; <$stdout> } // '';
    my $stderr_text = do { local $/; <$stderr> } // '';
    $stderr_text =~ s/\s+$//;
    waitpid $pid, 0;
    my $wait_status = $?;
    my $status = ($wait_status & 127) ? 128 + ($wait_status & 127) : $wait_status >> 8;
    return ($status, $stdout_text, $stderr_text);
}

sub run_value {
    my (@arguments) = @_;
    my ($status, $stdout, $stderr) = run_bubble(@arguments);
    return (undef, "exit=$status stderr=$stderr") if $status != 0;
    return (undef, "unexpected output=$stdout") unless $stdout =~ /^\s*($number)\s*$/;
    return ($1 + 0.0, '');
}

sub check_result {
    my ($name, $ok, $details) = @_;
    if ($ok) {
        ++$passed;
        print "OK: $name";
    } else {
        ++$failed;
        print "FAILED: $name";
    }
    print " ($details)" if defined $details && length $details;
    print "\n";
}

sub close_enough {
    my ($value, $expected, $relative, $absolute) = @_;
    return 0 unless defined $value;
    return abs($value - $expected) <= $absolute + $relative*abs($expected);
}

