#!/usr/bin/env perl

use strict;
use warnings;
use File::Temp qw(tempdir tempfile);
use FindBin qw($Bin);
use IO::Select;
use IPC::Open3;
use POSIX qw(WNOHANG);
use Symbol qw(gensym);
use Time::HiRes qw(time);

my $bubble = "$Bin/../bubble";
my $directory = tempdir(CLEANUP => 1);
my $passed = 0;
my $failed = 0;
my $command_timeout = $ENV{BUBBLE_TEST_TIMEOUT} // 120;
my $output_limit = 1024*1024;

sub write_table {
    my ($name, @rows) = @_;
    my $filename = "$directory/$name";
    open my $file, '>', $filename or die "Cannot create $filename: $!\n";
    print {$file} "$_\n" for @rows;
    close $file or die "Cannot close $filename: $!\n";
    return $filename;
}

sub run_bubble {
    my (@arguments) = @_;
    my $stdout = gensym;
    my $stderr = gensym;
    my $pid = open3(undef, $stdout, $stderr, $bubble, @arguments);

    my %captured = (stdout => '', stderr => '');
    my %stream_name = (
        fileno($stdout) => 'stdout',
        fileno($stderr) => 'stderr',
    );
    my $selector = IO::Select->new($stdout, $stderr);
    my $deadline = time + $command_timeout;
    my $capture_error;
    while ($selector->count) {
        my $remaining = $deadline - time;
        if ($remaining <= 0) {
            $capture_error = "command timed out after $command_timeout seconds";
            last;
        }
        my @ready = $selector->can_read($remaining);
        if (!@ready) {
            $capture_error = "command timed out after $command_timeout seconds";
            last;
        }
        for my $handle (@ready) {
            my $fd = fileno($handle);
            my $bytes = sysread($handle, my $chunk, 8192);
            if (!defined $bytes) {
                $capture_error = "unable to read $stream_name{$fd}: $!";
                last;
            }
            if ($bytes == 0) {
                $selector->remove($handle);
                close $handle;
                next;
            }
            $captured{$stream_name{$fd}} .= $chunk;
            if (length($captured{stdout}) + length($captured{stderr}) > $output_limit) {
                $capture_error = "command output exceeded $output_limit bytes";
                last;
            }
        }
        last if defined $capture_error;
    }
    my $wait_status;
    unless (defined $capture_error) {
        while (1) {
            my $waited = waitpid($pid, WNOHANG);
            if ($waited == $pid) {
                $wait_status = $?;
                last;
            }
            if ($waited == -1) {
                $capture_error = "unable to wait for command: $!";
                last;
            }
            my $remaining = $deadline - time;
            if ($remaining <= 0) {
                $capture_error = "command timed out after $command_timeout seconds";
                last;
            }
            my $pause = $remaining < 0.05 ? $remaining : 0.05;
            select undef, undef, undef, $pause;
        }
    }
    if (defined $capture_error) {
        kill 'KILL', $pid;
        waitpid $pid, 0;
        return (124, $captured{stdout}, "Test harness error: $capture_error");
    }

    my $stdout_text = $captured{stdout};
    my $stderr_text = $captured{stderr};
    my $status = ($wait_status & 127)
        ? 128 + ($wait_status & 127)
        : $wait_status >> 8;
    return ($status, $stdout_text, $stderr_text);
}

sub check_result {
    my ($name, $ok, $details) = @_;
    if ($ok) {
        ++$passed;
        print "OK: $name";
    } else {
        ++$failed;
        print "FAILED: $name";
    }
    print " ($details)" if defined $details && length $details;
    print "\n";
}

sub check_failure {
    my ($name, $pattern, @arguments) = @_;
    my ($status, $stdout, $stderr) = run_bubble(@arguments);
    my $ok = $status > 0 && $status < 128 && $stdout eq '' &&
        $stderr =~ $pattern;
    check_result($name, $ok, "exit=$status stdout=$stdout stderr=$stderr");
}

my @frequencies = (-10, -5, 0, 5, 10);
my $resigma = write_table('resigma.dat', map { "$_ 0" } @frequencies);
my $imsigma = write_table('imsigma.dat', map { "$_ -0.1" } @frequencies);

for my $case (
    [1, 'linear'],
    [2, 'cspline'],
    [3, 'akima'],
    [4, 'steffen'],
) {
    my ($selector, $method) = @$case;
    my @arguments = ('-v', 1, 0, 0, 0.1, 0, $resigma, $imsigma);
    my ($numeric_status, $numeric_stdout, $numeric_stderr) =
        run_bubble('-i', $selector, @arguments);
    my ($named_status, $named_stdout, $named_stderr) =
        run_bubble('-i', $method, @arguments);
    my ($long_numeric_status, $long_numeric_stdout, $long_numeric_stderr) =
        run_bubble("--interpolation=$selector", @arguments);
    my ($long_named_status, $long_named_stdout, $long_named_stderr) =
        run_bubble("--interpolation=$method", @arguments);
    check_result("numeric and named $method interpolation aliases agree",
        $numeric_status == 0 && $named_status == 0 &&
        $long_numeric_status == 0 && $long_named_status == 0 &&
        $numeric_stderr eq '' && $named_stderr eq '' &&
        $long_numeric_stderr eq '' && $long_named_stderr eq '' &&
        $numeric_stdout eq $named_stdout &&
        $numeric_stdout eq $long_numeric_stdout &&
        $numeric_stdout eq $long_named_stdout &&
        $numeric_stdout =~ /Sigma interpolation=\Q$method\E/,
        "short=$numeric_status/$named_status long=" .
        "$long_numeric_status/$long_named_status");
}

if (-e '/dev/full') {
    my @stdout_failure_cases = (
        ['calculation standard-output write failure is fatal',
            [1, 0, 0, 0.1, 0, $resigma, $imsigma]],
        ['help standard-output write failure is fatal', ['--help']],
    );
    for my $case (@stdout_failure_cases) {
        my ($name, $arguments) = @$case;
        my ($error_file) = tempfile(DIR => $directory);
        my $pid = fork();
        defined $pid or die "Cannot fork stdout failure test: $!\n";
        if ($pid == 0) {
            open STDOUT, '>', '/dev/full'
                or die "Cannot open /dev/full: $!\n";
            open STDERR, '>&', $error_file
                or die "Cannot redirect stderr: $!\n";
            exec { $bubble } $bubble, @$arguments;
            die "Cannot execute $bubble: $!\n";
        }
        my $deadline = time + $command_timeout;
        my ($wait_status, $capture_error);
        while (1) {
            my $waited = waitpid($pid, WNOHANG);
            if ($waited == $pid) {
                $wait_status = $?;
                last;
            }
            if ($waited == -1) {
                $capture_error = "unable to wait for command: $!";
                last;
            }
            my $error_size = -s $error_file;
            if (defined $error_size && $error_size > $output_limit) {
                $capture_error = "command output exceeded $output_limit bytes";
                last;
            }
            if (time >= $deadline) {
                $capture_error =
                    "command timed out after $command_timeout seconds";
                last;
            }
            select undef, undef, undef, 0.05;
        }
        if (defined $capture_error) {
            kill 'KILL', $pid;
            waitpid $pid, 0;
            die "Test harness error: $capture_error\n";
        }
        seek $error_file, 0, 0
            or die "Cannot rewind stdout failure stderr: $!\n";
        my $stderr = do { local $/; <$error_file> } // '';
        my $status = ($wait_status & 127)
            ? 128 + ($wait_status & 127)
            : $wait_status >> 8;
        check_result($name,
            $status == 1 && $stderr =~ /Error: failed to write standard output/,
            "exit=$status stderr=$stderr");
    }
} else {
    for my $name ('calculation standard-output write failure is fatal',
        'help standard-output write failure is fatal') {
        check_result($name, 1, '/dev/full unavailable; test skipped');
    }
}

my $comment_resigma = write_table('comment-resigma.dat',
    '# ReSigma header', '', '-10 0 # left edge', '-5 0',
    '0 0 # center', '5 0', '10 0 # right edge');
my $comment_imsigma = write_table('comment-imsigma.dat',
    '# ImSigma header', '-10 -0.1', '-5 -0.1 # comment', '',
    '0 -0.1', '5 -0.1', '10 -0.1');
my $comment_phi = write_table('comment-phi.dat',
    '# epsilon Phi', '-2 1', '-1 1 # inline', '', '0 1', '1 1', '2 1');
my ($comment_status, undef, $comment_stderr) = run_bubble(
    '-q', '-p', $comment_phi, 0, 0, 0, 0.1, 0,
    $comment_resigma, $comment_imsigma);
check_result('blank lines and comments are accepted',
    $comment_status == 0 && $comment_stderr eq '',
    "exit=$comment_status stderr=$comment_stderr");

my $missing_column = write_table('missing-column.dat', '-10 0', '-5', '0 0');
check_failure('missing column is rejected', qr/column 2 is missing/,
    1, 0, 0, 0.1, 0, $missing_column, $imsigma);

my $extra_column = write_table('extra-column.dat',
    '-10 0', '-5 0 extra', '0 0');
check_failure('extra column is rejected', qr/found extra token 'extra'/,
    1, 0, 0, 0.1, 0, $extra_column, $imsigma);

my $malformed_number = write_table('malformed-number.dat',
    '-10 0', '-5 0junk', '0 0');
check_failure('malformed numeric suffix is rejected',
    qr/invalid finite number in column 2: '0junk'/,
    1, 0, 0, 0.1, 0, $malformed_number, $imsigma);

my $nan_value = write_table('nan-value.dat', '-10 0', '-5 nan', '0 0');
check_failure('NaN is rejected', qr/invalid finite number in column 2: 'nan'/,
    1, 0, 0, 0.1, 0, $nan_value, $imsigma);

my $infinite_value = write_table('infinite-value.dat',
    '-10 0', '-5 -inf', '0 0');
check_failure('infinity is rejected', qr/invalid finite number in column 2: '-inf'/,
    1, 0, 0, 0.1, 0, $infinite_value, $imsigma);

my $overflow_value = write_table('overflow-value.dat',
    '-10 0', '-5 1e9999', '0 0');
check_failure('numeric overflow is rejected',
    qr/invalid finite number in column 2: '1e9999'/,
    1, 0, 0, 0.1, 0, $overflow_value, $imsigma);

my $underflow_value = write_table('underflow-value.dat',
    '-10 0', '-5 1e-9999', '0 0');
check_failure('numeric underflow is rejected',
    qr/invalid finite number in column 2: '1e-9999'/,
    1, 0, 0, 0.1, 0, $underflow_value, $imsigma);

my $empty_table = write_table('empty.dat', '', '# no data');
check_failure('empty table is rejected', qr/contains no data rows/,
    1, 0, 0, 0.1, 0, $empty_table, $imsigma);

check_failure('missing table is rejected', qr/unable to open file/,
    1, 0, 0, 0.1, 0, "$directory/missing.dat", $imsigma);

my $table_directory = "$directory/table-directory";
mkdir $table_directory or die "Cannot create $table_directory: $!\n";
check_failure('table read error is rejected', qr/I\/O error while reading file/,
    1, 0, 0, 0.1, 0, $table_directory, $imsigma);

my $duplicate_grid = write_table('duplicate-grid.dat',
    '-10 0', '-5 0', '-5 0', '0 0', '10 0');
check_failure('duplicate grid point is rejected',
    qr/grid is not strictly increasing/,
    1, 0, 0, 0.1, 0, $duplicate_grid, $imsigma);

my $descending_grid = write_table('descending-grid.dat',
    '-10 0', '0 0', '-5 0', '5 0', '10 0');
check_failure('descending grid point is rejected',
    qr/grid is not strictly increasing/,
    1, 0, 0, 0.1, 0, $descending_grid, $imsigma);

my $unrepresentable_span = write_table('unrepresentable-span.dat',
    '-1e308 0', '0 0', '1e308 0');
my $matching_large_im = write_table('matching-large-im.dat',
    '-1e308 -0.1', '0 -0.1', '1e308 -0.1');
check_failure('unrepresentable grid span is rejected',
    qr/grid span is not representable/,
    1, 0, 0, 0.1, 0, $unrepresentable_span, $matching_large_im);

my $short_imsigma = write_table('short-imsigma.dat',
    map { "$_ -0.1" } (-10, -5, 0, 5));
check_failure('self-energy row-count mismatch is rejected',
    qr/row count 4 does not match ReSigma table/,
    1, 0, 0, 0.1, 0, $resigma, $short_imsigma);

my $mismatched_imsigma = write_table('mismatched-imsigma.dat',
    '-10 -0.1', '-5 -0.1', '0.00000000000000001 -0.1',
    '5 -0.1', '10 -0.1');
check_failure('self-energy frequency mismatch is rejected',
    qr/frequency .* does not match ReSigma table/,
    1, 0, 0, 0.1, 0, $resigma, $mismatched_imsigma);

my $four_resigma = write_table('four-resigma.dat',
    map { "$_ 0" } (-10, -2, 2, 10));
my $four_imsigma = write_table('four-imsigma.dat',
    map { "$_ -0.1" } (-10, -2, 2, 10));
check_failure('undersized Akima self-energy table is rejected',
    qr/interpolation 'akima' requires at least 5 rows; found 4/,
    '-i', 3, 1, 0, 0, 0.1, 0, $four_resigma, $four_imsigma);

my $two_resigma = write_table('two-resigma.dat', '-10 0', '10 0');
my $two_imsigma = write_table('two-imsigma.dat', '-10 -0.1', '10 -0.1');
check_failure('undersized numeric Steffen self-energy table is rejected',
    qr/interpolation 'steffen' requires at least 3 rows; found 2/,
    '-i', 4, 1, 0, 0, 0.1, 0, $two_resigma, $two_imsigma);
check_failure('undersized named Steffen self-energy table is rejected',
    qr/interpolation 'steffen' requires at least 3 rows; found 2/,
    '--interpolation', 'steffen', 1, 0, 0, 0.1, 0,
    $two_resigma, $two_imsigma);

my $three_resigma = write_table('three-resigma.dat', '-10 0', '0 1', '10 0');
my $three_imsigma = write_table('three-imsigma.dat',
    '-10 -0.1', '0 -0.2', '10 -0.1');
my ($three_row_status, undef, $three_row_stderr) = run_bubble(
    '--interpolation=steffen', 1, 0, 0, 0.1, 0,
    $three_resigma, $three_imsigma);
check_result('three-row Steffen self-energy table succeeds',
    $three_row_status == 0 && $three_row_stderr eq '',
    "exit=$three_row_status stderr=$three_row_stderr");

my ($last_linear_status, undef, $last_linear_stderr) = run_bubble(
    '-i', 'akima', '--interpolation', 'linear',
    1, 0, 0, 0.1, 0, $two_resigma, $two_imsigma);
check_result('last self-energy interpolation option wins',
    $last_linear_status == 0 && $last_linear_stderr eq '',
    "exit=$last_linear_status stderr=$last_linear_stderr");
check_failure('last self-energy interpolation option sets the row minimum',
    qr/interpolation 'akima' requires at least 5 rows; found 2/,
    '-i', 'linear', '--interpolation', 'akima',
    1, 0, 0, 0.1, 0, $two_resigma, $two_imsigma);

my $one_row_phi = write_table('one-row-phi.dat', '0 1');
check_failure('undersized Phi table is rejected',
    qr/interpolation 'steffen' requires at least 3 rows; found 1/,
    '-p', $one_row_phi, 0, 0, 0, 0.1, 0, $resigma, $imsigma);

my $two_row_phi = write_table('two-row-phi.dat', '-1 -1', '1 1');
my ($linear_phi_status, undef, $linear_phi_stderr) = run_bubble(
    '--phi-interpolation', 'linear', '-p', $two_row_phi,
    0, 0, 0, 0.1, 0, $resigma, $imsigma);
check_result('two-row linear Phi interpolation succeeds',
    $linear_phi_status == 0 && $linear_phi_stderr eq '',
    "exit=$linear_phi_status stderr=$linear_phi_stderr");
check_failure('undersized cspline Phi table is rejected',
    qr/interpolation 'cspline' requires at least 3 rows; found 2/,
    '--phi-interpolation', 'cspline', '-p', $two_row_phi,
    0, 0, 0, 0.1, 0, $resigma, $imsigma);
check_failure('undersized Steffen Phi table is rejected',
    qr/interpolation 'steffen' requires at least 3 rows; found 2/,
    '--phi-interpolation', 'steffen', '-p', $two_row_phi,
    0, 0, 0, 0.1, 0, $resigma, $imsigma);

my $three_row_signed_phi = write_table('three-row-signed-phi.dat',
    '-1 -1', '0 0.5', '1 1');
my ($steffen_phi_status, undef, $steffen_phi_stderr) = run_bubble(
    '--phi-interpolation=steffen', '-p', $three_row_signed_phi,
    0, 0, 0, 0.1, 0, $resigma, $imsigma);
check_result('explicit Steffen accepts signed Phi',
    $steffen_phi_status == 0 && $steffen_phi_stderr eq '',
    "exit=$steffen_phi_status stderr=$steffen_phi_stderr");

my $four_row_signed_phi = write_table('four-row-signed-phi.dat',
    '-2 1', '-1 1', '0 -1', '1 1');
check_failure('undersized signed Phi table is rejected',
    qr/interpolation 'akima' requires at least 5 rows; found 4/,
    '-p', $four_row_signed_phi, 0, 0, 0, 0.1, 0, $resigma, $imsigma);
check_failure('explicit undersized Akima Phi table is rejected',
    qr/interpolation 'akima' requires at least 5 rows; found 4/,
    '--phi-interpolation', 'akima', '-p', $four_row_signed_phi,
    0, 0, 0, 0.1, 0, $resigma, $imsigma);

my $malformed_phi = write_table('malformed-phi.dat',
    '-2 1', '-1 1', '0 1 extra', '1 1', '2 1');
check_failure('malformed Phi row is rejected', qr/found extra token 'extra'/,
    '-p', $malformed_phi, 0, 0, 0, 0.1, 0, $resigma, $imsigma);

my $overflow_phi = write_table('overflow-phi.dat',
    '0 1', '1 1', '2 1', '3 1', '1e200 1e200');
check_failure('non-finite transformed Phi is rejected',
    qr/applying epsilon power e=1 produced a non-finite Phi value/,
    '-e', 1, '-p', $overflow_phi, 0, 0, 0, 0.1, 0, $resigma, $imsigma);

my $empty_phi = write_table('empty-phi.dat', '# no Phi data');
check_failure('empty Phi table is rejected', qr/contains no data rows/,
    '-p', $empty_phi, 0, 0, 0, 0.1, 0, $resigma, $imsigma);

check_failure('invalid Phi interpolation is rejected',
    qr/Phi interpolation method must be one of/,
    '--phi-interpolation', 'nearest', 1, 0, 0, 0.1, 0, $resigma, $imsigma);
check_failure('case-mismatched Phi interpolation is rejected',
    qr/Phi interpolation method must be one of/,
    '--phi-interpolation', 'Steffen', 1, 0, 0, 0.1, 0, $resigma, $imsigma);
for my $case (
    ['automatic', 'auto'],
    ['case-mismatched', 'Steffen'],
    ['unknown', 'nearest'],
    ['zero', '0'],
    ['out-of-range', '5'],
    ['malformed numeric', '1junk'],
) {
    my ($name, $method) = @$case;
    check_failure("$name self-energy interpolation is rejected",
        qr/Self-energy interpolation method must be one of/,
        '-i', $method, 1, 0, 0, 0.1, 0, $resigma, $imsigma);
}
check_failure('invalid long self-energy interpolation is rejected',
    qr/Self-energy interpolation method must be one of/,
    '--interpolation=auto', 1, 0, 0, 0.1, 0, $resigma, $imsigma);
check_failure('invalid GSL error policy is rejected',
    qr/GSL error policy must be one of/,
    '--gsl-error-policy', 'abort', 1, 0, 0, 0.1, 0, $resigma, $imsigma);

for my $case (
    ['zero', '0', qr/must be a positive integer/],
    ['negative', '-1', qr/must be a positive integer/],
    ['signed', '+1', qr/must be a positive integer/],
    ['fractional', '1.5', qr/must be a positive integer/],
    ['suffix', '1x', qr/must be a positive integer/],
    ['overflowing', '9999999999999999999999999999999999', qr/is too large/],
) {
    my ($name, $value, $diagnostic) = @$case;
    check_failure("$name workspace limit is rejected", $diagnostic,
        '--workspace-limit', $value,
        1, 0, 0, 0.1, 0, $resigma, $imsigma);
}

print "INPUT OK=$passed FAILED=$failed\n";
exit($failed == 0 ? 0 : 1);
